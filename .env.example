# ─────────────────────────────────────────────────────────────────────────────
# Aureon — example environment. Copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.
# See DOCUMENTATION.md §5 for how to obtain each value.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin. Must match the URL the app is actually served from, or
# OAuth/email redirect links will point at the wrong place.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev banners only. Set both to false in production.
DEVELOPMENT_MODE=false
NEXT_PUBLIC_DEVELOPMENT_MODE=false

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by the Stripe webhook and admin reads. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (required for payments) ───────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you register at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Marketplace fee percentage (default 10)
STRIPE_PLATFORM_FEE_PERCENT=10

# ── Resend (required for transactional email) ────────────────────────────────
RESEND_API_KEY=re_xxx
# Must be an address on a domain you've verified in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── OAuth (configured in the Supabase dashboard, not read by the app) ────────
# Google/Apple credentials are entered in Supabase → Authentication → Providers.
# See DOCUMENTATION.md §5.2. Listed here for reference only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ── Blockchain (Phase 2 — local Hardhat node) ────────────────────────────────
# All values have sensible local-dev defaults; you only need these to override.
# RPC endpoint the browser reads provenance from.
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=31337
# Server-side signer for platform actions (mint/attest/transfer). Defaults to
# Hardhat's well-known account #0 key. LOCAL DEV ONLY — never use a real key.
BLOCKCHAIN_OPERATOR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
