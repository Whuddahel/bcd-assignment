# Local development. Not committed. See .env.example for the documented list.
#
# Currently pointed at the HOSTED Supabase project (aureon /
# ydgsjkzasildcsfdmyfg). To go back to the local Docker stack, comment out the
# hosted block and uncomment the local one, then restart the dev server.
 
# 3001, not 3000 — another container already holds 3000 on this machine, so
# `next dev` falls back. Must match the port the dev server actually uses or
# email/OAuth redirect links point at the wrong app.
NEXT_PUBLIC_APP_URL=http://localhost:3001
 
DEVELOPMENT_MODE=true
NEXT_PUBLIC_DEVELOPMENT_MODE=true
 
