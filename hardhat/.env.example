# Only needed for `npm run deploy:sepolia` — the default `npm run node` /
# `npm run deploy` (local Hardhat node) needs none of this.
#
# Copy to hardhat/.env (gitignored) and fill in.

# Optional — the config already falls back to a free public Sepolia RPC
# (https://ethereum-sepolia-rpc.publicnode.com) if this is unset. Set your own
# Alchemy/Infura URL here only if you want higher rate limits.
SEPOLIA_RPC_URL=

# Required for deploy:sepolia — the private key of a throwaway wallet funded
# with a little Sepolia test ETH (get some free from a faucet, e.g.
# https://cloud.google.com/application/web3/faucet/ethereum/sepolia). This
# becomes the on-chain operator/attestor — never use a real, funded key here.
DEPLOYER_KEY=
